{
  "Astro component": {
    "prefix": "astrocomp",
    "body": [
      "---",
      "interface Props {",
      "\t$1",
      "}",
      "",
      "const { $2 } = Astro.props;",
      "---",
      "",
      "<div>",
      "\t$0",
      "</div>"
    ],
    "description": "Scaffold komponen Astro (frontmatter + template)"
  },
  "Astro layout page": {
    "prefix": "astrolayout",
    "body": [
      "---",
      "import Layout from \"${1:../layouts/Layout.astro}\";",
      "---",
      "",
      "<Layout title=\"${2:Judul}\">",
      "\t$0",
      "</Layout>"
    ],
    "description": "Halaman Astro dengan Layout wrapper"
  }
}
