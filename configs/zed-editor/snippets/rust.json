{
  "Main function": {
    "prefix": "main",
    "body": ["fn main() {", "\t$0", "}"],
    "description": "Entry point fn main()"
  },
  "Tokio async main": {
    "prefix": "tmain",
    "body": [
      "#[tokio::main]",
      "async fn main() -> anyhow::Result<()> {",
      "\t$0",
      "",
      "\tOk(())",
      "}"
    ],
    "description": "Async main dengan tokio + anyhow"
  },
  "Test module": {
    "prefix": "testmod",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "\tuse super::*;",
      "",
      "\t#[test]",
      "\tfn ${1:it_works}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Modul unit test"
  },
  "Derive common": {
    "prefix": "der",
    "body": [
      "#[derive(Debug, Clone, ${1:PartialEq})]",
      "pub struct ${2:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Struct dengan derive umum"
  },
  "Error enum (thiserror)": {
    "prefix": "errenum",
    "body": [
      "#[derive(Debug, thiserror::Error)]",
      "pub enum ${1:MyError} {",
      "\t#[error(\"${2:pesan error}\")]",
      "\t${3:Variant},",
      "}"
    ],
    "description": "Enum error dengan thiserror"
  },
  "Axum handler": {
    "prefix": "axhandler",
    "body": [
      "async fn ${1:handler_name}(",
      "\tState(state): State<${2:AppState}>,",
      ") -> impl IntoResponse {",
      "\t$0",
      "}"
    ],
    "description": "Handler Axum dengan shared state"
  },
  "Dioxus component": {
    "prefix": "rsxc",
    "body": [
      "#[component]",
      "fn ${1:ComponentName}($2) -> Element {",
      "\trsx! {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Komponen Dioxus (fn + rsx!)"
  }
}
